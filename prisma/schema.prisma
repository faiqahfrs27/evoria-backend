// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sample {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("samples")
}

enum Role {
  ORGANIZER
  USER
}

enum EventCategory {
  MUSIC
  SPORTS
  FOOD
  ART
  EDUCATION
  OTHER
}

enum TransactionStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_ADMIN_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar()
  email    String @unique
  password String

  role       Role    @default(USER)
  profilePic String?

  referralCode String @unique @default(uuid())

  events Event[]

  transactions Transaction[] @relation("CustomerTransactions")

  //self relation
  referredById String? @db.Uuid
  referredBy   User?   @relation("UserReferral", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferral")

  //referral usage relations
  referralUsagesGiven    ReferralUsage[] @relation("Referrer")
  referralUsagesReceived ReferralUsage[] @relation("Referred")

  refreshTokens RefreshToken?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  points    Point[]
  coupons   Coupon[]

  @@map("users")
}

model Event {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar()
  slug           String        @unique
  description    String
  category       EventCategory
  location       String
  startDate      DateTime
  endDate        DateTime
  price          Int           @default(0)
  isFree         Boolean       @default(true)
  availableSeats Int
  totalSeats     Int
  imageUrl       String?
  organizerId    String        @db.Uuid
  organizer      User          @relation(fields: [organizerId], references: [id])
  ticketTypes    TicketType[]
  vouchers       Voucher[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]

  @@map("events")
}

model TicketType {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar()
  price        Int
  quota        Int
  eventId      String        @db.Uuid
  event        Event         @relation(fields: [eventId], references: [id])
  transactions Transaction[]

  @@map("ticket_types")
}

model Voucher {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  discountAmount Int
  startDate      DateTime
  endDate        DateTime
  quota          Int
  usedCount      Int           @default(0)
  eventId        String        @db.Uuid
  event          Event         @relation(fields: [eventId], references: [id])
  createdAt      DateTime      @default(now())
  transactions   Transaction[]

  @@map("vouchers")
}

model ReferralUsage {
  id String @id @default(uuid()) @db.Uuid

  referrerId String @db.Uuid
  referrer   User   @relation("Referrer", fields: [referrerId], references: [id])

  referredUserId String @unique @db.Uuid
  referredUser   User   @relation("Referred", fields: [referredUserId], references: [id])

  createdAt DateTime @default(now())

  @@map("referral_usages")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String   @unique @db.Uuid
  expiredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Point {
  id        String   @id @default(uuid())
  userId    String   @db.Uuid
  amount    Int
  source    String
  expiresAt DateTime
  isExpired Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("points")
}

model Coupon {
  id              String   @id @default(uuid())
  userId          String   @db.Uuid
  code            String   @unique
  discountPercent Int
  source          String
  eventId         String?  @db.Uuid
  expiresAt       DateTime
  isUsed          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("coupons")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  customer        User              @relation("CustomerTransactions", fields: [customerId], references: [id])
  eventId         String            @db.Uuid
  event           Event             @relation(fields: [eventId], references: [id])
  ticketTypeId    String?           @db.Uuid
  ticketType      TicketType?       @relation(fields: [ticketTypeId], references: [id])
  voucherId       String?           @db.Uuid
  voucher         Voucher?          @relation(fields: [voucherId], references: [id])
  status          TransactionStatus @default(WAITING_FOR_PAYMENT)
  quantity        Int               @default(1)
  basePrice       Int
  finalPrice      Int
  pointUsed       Int               @default(0)
  paymentProof    String?
  paymentDeadline DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("transactions")
}
