generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sample {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("samples")
}

model User {
  id                     String               @id @default(uuid()) @db.Uuid
  name                   String               @db.VarChar
  email                  String               @unique
  password               String
  role                   Role                 @default(USER)
  profilePic             String?
  provider               Provider             @default(CREDENTIALS)
  referralCode           String               @unique @default(uuid())
  referredById           String?              @db.Uuid
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  coupons                Coupon[]
  events                 Event[]
  passwordResetTokens    PasswordResetToken[]
  points                 Point[]
  referralUsagesReceived ReferralUsage?       @relation("Referred")
  referralUsagesGiven    ReferralUsage[]      @relation("Referrer")
  refreshTokens          RefreshToken?
  reviews                Review[]             @relation("CustomerReviews")
  transactions           Transaction[]        @relation("CustomerTransactions")
  referredBy             User?                @relation("UserReferral", fields: [referredById], references: [id])
  referrals              User[]               @relation("UserReferral")

  @@map("users")
}

model Event {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar
  slug           String        @unique
  description    String
  category       EventCategory
  location       String
  startDate      DateTime
  endDate        DateTime
  price          Int           @default(0)
  isFree         Boolean       @default(true)
  availableSeats Int
  totalSeats     Int
  imageUrl       String?
  organizerId    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  organizer      User          @relation(fields: [organizerId], references: [id])
  reviews        Review[]
  ticketTypes    TicketType[]
  transactions   Transaction[]
  vouchers       Voucher[]

  @@map("events")
}

model TicketType {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar
  price        Int
  quota        Int
  eventId      String        @db.Uuid
  event        Event         @relation(fields: [eventId], references: [id])
  transactions Transaction[]

  @@map("ticket_types")
}

model Voucher {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  discountAmount Int
  startDate      DateTime
  endDate        DateTime
  quota          Int
  usedCount      Int           @default(0)
  eventId        String        @db.Uuid
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  event          Event         @relation(fields: [eventId], references: [id])

  @@map("vouchers")
}

model ReferralUsage {
  id             String   @id @default(uuid()) @db.Uuid
  referrerId     String   @db.Uuid
  referredUserId String   @unique @db.Uuid
  createdAt      DateTime @default(now())
  referredUser   User     @relation("Referred", fields: [referredUserId], references: [id])
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])

  @@map("referral_usages")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String   @unique @db.Uuid
  expiredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Point {
  id        String   @id @default(uuid())
  userId    String   @db.Uuid
  amount    Int
  source    String
  expiresAt DateTime
  isExpired Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("points")
}

model Coupon {
  id              String        @id @default(uuid())
  userId          String        @db.Uuid
  code            String        @unique
  discountPercent Int
  source          String
  eventId         String?       @db.Uuid
  expiresAt       DateTime
  isUsed          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  transactions    Transaction[]
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("coupons")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiredAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  eventId         String            @db.Uuid
  ticketTypeId    String?           @db.Uuid
  voucherId       String?           @db.Uuid
  couponId        String?
  status          TransactionStatus @default(WAITING_FOR_PAYMENT)
  quantity        Int               @default(1)
  basePrice       Int
  finalPrice      Int
  pointUsed       Int               @default(0)
  paymentProof    String?
  paymentDeadline DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  customer        User              @relation("CustomerTransactions", fields: [customerId], references: [id])
  event           Event             @relation(fields: [eventId], references: [id])
  ticketType      TicketType?       @relation(fields: [ticketTypeId], references: [id])
  voucher         Voucher?          @relation(fields: [voucherId], references: [id])
  coupon          Coupon?           @relation(fields: [couponId], references: [id])

  @@map("transactions")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  eventId    String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id])
  event      Event    @relation(fields: [eventId], references: [id])

  @@unique([customerId, eventId])
  @@map("reviews")
}

enum Role {
  ORGANIZER
  USER
}

enum EventCategory {
  MUSIC
  SPORTS
  FOOD
  ART
  EDUCATION
  OTHER
}

enum TransactionStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_ADMIN_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

enum Provider {
  CREDENTIALS
  GOOGLE
}